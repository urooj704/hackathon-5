# Example .env for production deployment (Hugging Face, Vercel)
#
# 1. Copy to `.env` and fill in real secrets for production.
# 2. Do NOT use localhost or dev credentials in production.
# 3. Never commit real secrets to GitHub.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>?sslmode=require

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://<host>:<port>/0

# ─── LLM Providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini

# ─── Gmail OAuth ─────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://<your-hf-backend-url>/channels/gmail/oauth/callback
GMAIL_CREDENTIALS_FILE=gmail_token.json
SUPPORT_EMAIL=support@flowforge.io

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=flowforge_verify
WHATSAPP_API_VERSION=v20.0

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=<your-production-secret-key>
LOG_LEVEL=INFO

# ─── Agent Behaviour ─────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_TICKETS=3
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
