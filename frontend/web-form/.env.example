# Example environment variables for FlowForge Support Form
# Copy to `.env.local` for local dev, or set in Vercel → Project → Settings → Environment Variables.

# Public Hugging Face Space API (no trailing slash). Must match your Space URL after deploy.
NEXT_PUBLIC_API_URL=https://ujjee-hackathon-5.hf.space

# Server-side proxy to the same backend (Next.js API routes). Defaults to NEXT_PUBLIC_API_URL.
BACKEND_URL=
