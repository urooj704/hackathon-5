# Root-level example for Hugging Face Space secrets and local tooling.
# Backend-specific variables are documented in backend/.env.example
#
# Hugging Face: Settings → Repository secrets → Variables for the Space.

# Optional: force full FastAPI backend (requires DATABASE_URL and other backend secrets)
USE_FULL_BACKEND=false

# When using full backend, set the same variables as backend/.env.example using HF secret names:
# DATABASE_URL, REDIS_URL, ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY, etc.

# Frontend (Vercel / .env.local in frontend/web-form)
NEXT_PUBLIC_API_URL=https://ujjee-hackathon-5.hf.space
BACKEND_URL=https://ujjee-hackathon-5.hf.space
